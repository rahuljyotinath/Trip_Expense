# Primary production database (Vercel ↔ Supabase integration sets POSTGRES_URL).
POSTGRES_URL=
DATABASE_URL=

# Optional: import / legacy file ledger on GitHub.
# Fine-grained PAT with Contents: Read and write on rahuljyotinath/Trip_Expense.
GITHUB_TOKEN=
GITHUB_REPO=rahuljyotinath/Trip_Expense
GITHUB_BRANCH=main
GITHUB_DB_PATH=data/store.json

# Sign-in session cookie (recommended; optional on Vercel if GITHUB_TOKEN is set)
SESSION_SECRET=
