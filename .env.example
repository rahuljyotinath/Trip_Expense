# Primary production database (Vercel ↔ Supabase integration sets POSTGRES_URL).
POSTGRES_URL=
DATABASE_URL=

# Sign-in session cookie (required in production)
SESSION_SECRET=

# Public site URL (deep links, PWA, Capacitor). Production: https://your-domain
NEXT_PUBLIC_APP_URL=

# Optional label (Vercel Preview sets Tripzy_Development automatically). Local friend DB:
# NEXT_PUBLIC_APP_DISPLAY_NAME=Tripzy_Development

# Capacitor shell loads this origin (defaults in apps/mobile/capacitor.config.ts)
CAPACITOR_SERVER_URL=

# Optional structured request timings (no SQL, credentials, or ledger content).
LEDGER_PERF_LOG=0
